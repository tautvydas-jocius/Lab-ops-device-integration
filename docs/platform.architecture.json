  "cards": [
    {
      "dot": "cyan",
      "title": "Firmware loop (single thread)",
      "items": [
        "pumpSerial drains the UART, 2 KB RX buffer",
        "Pumped inside uploads, OTA and CRC passes",
        "Persistent diag counters + 16-event ring in NVS"
      ]
    },
    {
      "dot": "emerald",
      "title": "MQTT topics",
      "items": [
        "raw, status, diag up; config, cmd, ack",
        "file/{xfer}/meta|n + file_ack (binary 4 KB chunks)",
        "ota_req -> ota/{image}/{n} (signed, SHA-256 checked)"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "cmd and file meta HMAC-signed with a per-device token",
        "API and admin actions need a bearer token or login"
      ]
    }
  ]
